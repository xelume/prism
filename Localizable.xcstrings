    "error.process.inspectCodexFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to check running Codex tasks, so the account was not switched. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
