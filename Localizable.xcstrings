    "alert.deleteAccount.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete This Account Backup?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除这个账号备份？"
          }
        }
      }
    },
    "alert.deleteAccount.currentMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the Prism Keychain backup will be deleted. You will remain signed in, and Prism will safely save the latest credentials when you switch away later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只会删除 Prism 钥匙串中的备份，不会退出当前登录。之后切换账号时，Prism 仍会按安全流程保存离开账号的最新认证。"
          }
        }
      }
    },
    "alert.deleteAccount.savedMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After deletion, you cannot switch to this account in Prism until you add it or sign in again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除后不能再从 Prism 切换到这个账号，需要重新添加或登录。"
          }
        }
      }
    },
    "alert.deleteAccount.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Backup"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除备份"
          }
        }
      }
    },
