    },
    "error.process.terminationFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to stop %@, so the account was not switched. Quit ChatGPT manually and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
