    "about.securityTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account Security"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号安全说明"
          }
        }
      }
